# Bedrock local dev — env template
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Once phase 06 lands and `apps/query-svc/` exists, the TRINO_* block
# moves to `apps/query-svc/.env`. Catalog API vars move to
# `apps/catalog-api/.env`. Until then, root `.env` is the single source
# of truth for local-only secrets.

# ─── Trino (VNG GIO) ──────────────────────────────────────────────────
# Auth: HTTP Basic. JDBC URL form: jdbc:trino://<host>:<port>
# Get credentials from VNG password manager — never paste into chat.
TRINO_HOST=10.164.54.181
TRINO_HOST_FQDN=gio-gds-trino.vnggames.net
TRINO_PORT=8080
TRINO_USER=your.handle
TRINO_PASSWORD=replace-me
TRINO_CATALOG=iceberg
TRINO_DEFAULT_SCHEMA=cfm_vn
TRINO_QUERY_TIMEOUT_MS=30000

# ─── Catalog API ──────────────────────────────────────────────────────
DATABASE_URL=postgres://bedrock:dev@localhost:5432/bedrock
JWT_SECRET=replace-with-random-32-bytes
AUTH_DEV_USER=your.handle@vng.com.vn
NODE_ENV=development
PORT_CATALOG=3001

# ─── Query Service ────────────────────────────────────────────────────
# Driver: 'mock' reads infra/trino-mock/data/*.jsonl; 'trino' uses TRINO_* above.
QUERY_DRIVER=mock
CATALOG_API=http://localhost:3001/api/v1
PORT_QUERY=3002

# ─── Web (Vite) ───────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:3001/api/v1
VITE_QUERY_BASE=http://localhost:3002/api/v1
# Toggle between live API (true) and existing JSX mock fallback (false)
VITE_USE_API=false
