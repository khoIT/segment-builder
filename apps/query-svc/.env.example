# Bedrock Query Service — local dev
# Copy to apps/query-svc/.env. Never commit .env.
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=replace-me-locally-with-32-bytes-of-randomness
WEB_ORIGIN=http://localhost:5173

# Driver selection: 'mock' (seeded RNG + JSONL fixtures) or 'trino' (phase 06).
QUERY_DRIVER=mock

# Catalog API base URL — query-svc looks up metric/segment metadata.
CATALOG_API=http://localhost:3001/api/v1

# Trino (phase 06; ignored when QUERY_DRIVER=mock)
TRINO_HOST_FQDN=gio-gds-trino.vnggames.net
TRINO_PORT=8080
TRINO_USER=
TRINO_PASSWORD=
TRINO_CATALOG=iceberg
TRINO_DEFAULT_SCHEMA=cfm_vn
TRINO_QUERY_TIMEOUT_MS=30000
